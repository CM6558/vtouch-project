{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build: vtouchd (arm64 · 全部模块)",
      "detail": "sh scripts/build.sh —— NDK 交叉编译 src/*.c → build/vtouchd（-Wall -Wextra -Werror）",
      "type": "shell",
      "command": "sh scripts/build.sh",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "build: vtouchd_ui (核心 + 内嵌面板)",
      "detail": "sh scripts/ui-deploy.sh build —— 先编面板(real)再编带 UI 的核心；不需要 adb",
      "type": "shell",
      "command": "sh scripts/ui-deploy.sh build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "check: 语法检查当前文件（NDK clang）",
      "detail": "只跑 -fsyntax-only，秒级；用的是 build.sh 同一套 NDK 与同一组告警开关",
      "type": "shell",
      "command": "sh scripts/check_syntax.sh \"${relativeFile}\"",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "device: deploy（推二进制并对账 md5）",
      "detail": "sh scripts/deploy.sh deploy —— 需要 adb + 设备 root",
      "type": "shell",
      "command": "sh scripts/deploy.sh deploy",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "device: start（起 daemon）",
      "type": "shell",
      "command": "sh scripts/deploy.sh start",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "device: stop（停 daemon，释放物理触摸）",
      "type": "shell",
      "command": "sh scripts/deploy.sh stop",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "device: status（pid + 日志尾部）",
      "type": "shell",
      "command": "sh scripts/deploy.sh status",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    },
    {
      "label": "doc: 重建函数文档（幂等）",
      "detail": "python scripts/apply_funcdoc.py —— 文案改在 scripts/funcdoc_data.py；跑完二进制应字节不变",
      "type": "shell",
      "command": "python scripts/apply_funcdoc.py",
      "options": {
        "cwd": "${workspaceFolder}"
      }
    }
  ]
}
