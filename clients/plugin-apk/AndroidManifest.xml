<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        package="org.vtouch.plugin"
        android:versionCode="2"
        android:versionName="2.0.0">

        <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
        <uses-permission android:name="android.permission.WAKE_LOCK" />

        <application android:label="VTouch Plugin" android:hasCode="true">

                    <!-- AutoJs6 插件注册入口：value 为 VTouchPlugin 的全限定类名 -->
                    <meta-data
                                    android:name="org.autojs.plugin.sdk.registry"
                                    android:value="org.vtouch.plugin.VTouchPlugin" />

                    <!-- 后台托管服务：显式 startService 拉起 vtouchmerge/vtouchws -->
                    <service
                                    android:name=".VTouchService"
                                    android:exported="false"
                                    android:stopWithTask="false" />

        </application>
</manifest>
