<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
        package="org.vtouch.plugin"
        android:versionCode="3"
        android:versionName="2.0.1">

        <!-- targetSdk 28：避免 Android 14+ 前台服务类型强制校验（本机仅 android-24 platform，无法声明 type/specialUse） -->
        <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="28" />

        <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
        <uses-permission android:name="android.permission.WAKE_LOCK" />

        <application android:label="VTouch Plugin" android:hasCode="true">

                    <!-- AutoJs6 插件注册入口：value 为 VTouchPlugin 的全限定类名 -->
                    <meta-data
                                    android:name="org.autojs.plugin.sdk.registry"
                                    android:value="org.vtouch.plugin.VTouchPlugin" />

                    <!-- 后台托管服务：插件主路径（脚本 load 启动 / 脚本退出停止）。
                         exported=true 必须：AutoJs6 经 createPackageContext 跨包 startService。 -->
                    <service
                                    android:name=".VTouchService"
                                    android:exported="true"
                                    android:stopWithTask="false" />

                    <!-- 最小启动入口：ColorOS 启动管理要求应用被打开过一次才允许后台拉起。
                         打开即提示并结束，不进最近任务。 -->
                    <activity
                                    android:name=".MainActivity"
                                    android:exported="true"
                                    android:excludeFromRecents="true"
                                    android:finishOnTaskLaunch="true"
                                    android:theme="@android:style/Theme.Translucent.NoTitleBar">
                                    <intent-filter>
                                                    <action android:name="android.intent.action.MAIN" />
                                                    <category android:name="android.intent.category.LAUNCHER" />
                                    </intent-filter>
                    </activity>

        </application>
</manifest>
